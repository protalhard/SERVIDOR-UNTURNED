[Unit]
Description=Site do DAY Z BRASIL OFICIAL
After=network-online.target
Wants=network-online.target

[Service]
User=unturned
ExecStart=/usr/local/bin/dz-site -addr :80 -dominio dayz.snaplag.com.br -dominio-admin painel-dz.snaplag.com.br
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=10
MemoryMax=60M

[Install]
WantedBy=multi-user.target
