  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="RocketModFix.Unturned.Redist.Server" Version="3.26.3.12" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="RocketModFix.UnityEngine.Redist" Version="2022.3.62.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="RocketModFix.Rocket.Unturned" Version="4.23.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="modelos/montar_modelos.tsv" LogicalName="montar_modelos.tsv" />
  </ItemGroup>
</Project>
